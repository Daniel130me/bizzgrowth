# Copy this file to .env.local for local development.
# Never put real credentials in this template or commit a populated env file.

# This app currently uses SQLite (see prisma/schema.prisma).
# The path is relative to prisma/schema.prisma and points to db/custom.db.
DATABASE_URL="file:../db/custom.db"

NODE_ENV=development
PORT=3007

# AI provider order; z.ai uses platform credentials, other providers are optional.
# Supported providers: z.ai, openai, groq, openrouter, gemini
AI_GATEWAY_ORDER=z.ai,openai,groq,openrouter,gemini
AI_GATEWAY_TIMEOUT_MS=45000
AI_GATEWAY_COOLDOWN_MS=60000
BIZZ_AI_DISABLED=0

# Add keys for the providers you want to enable. Multiple keys may be comma-separated.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=""
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.5-flash-lite
ZAI_API_KEY=""
ZAI_MODEL=glm-4.7-flash
