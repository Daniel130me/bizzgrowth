# Copy this file to .env.production on the droplet. Never commit that file.
# DOMAIN is consumed by the Nginx configuration template.
DOMAIN=app.example.com
APP_URL=https://app.example.com

# Neon PostgreSQL: use the pooled URL at runtime and the direct URL only for
# reviewed, additive SQL changes. This repository intentionally does not run
# Prisma migrations during container startup; see docs/deployment.md.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Defaults target the current 1 vCPU / 512 MB / 10 GB Droplet. Keep the Node
# heap below the container limit so native modules and the runtime have room.
NODE_MAX_OLD_SPACE_SIZE_MB=192
APP_CPU_LIMIT=0.85
APP_MEMORY_LIMIT=288m
NGINX_CPU_LIMIT=0.15
NGINX_MEMORY_LIMIT=32m
NGINX_CLIENT_MAX_BODY_SIZE=10m
LOG_MAX_SIZE=5m
LOG_MAX_FILES=3

# Required before enabling third-party connectors. Generate once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the same key across releases; changing it makes stored tokens unreadable.
CONNECTIONS_ENCRYPTION_KEY=

# Google read-only connector. The redirect URI must match the Web OAuth client
# in Google Cloud exactly. Local development uses http://localhost:3007.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/api/connect/google/callback
# Google Ads additionally requires an approved developer token. Keep the API
# version explicit so upgrades are reviewed instead of changing implicitly.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v26

# Meta read-only connector. The redirect URI must exactly match a valid OAuth
# redirect URI in the Meta app. Public users require approved permissions.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://app.example.com/api/connect/meta/callback
META_GRAPH_VERSION=v27.0

# TikTok Ads uses a generated Advertiser authorization URL from the TikTok For
# Business developer portal. Profile/video analytics uses a separate Login Kit app.
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_ADS_AUTH_URL=
TIKTOK_ADS_REDIRECT_URI=https://app.example.com/api/connect/tiktok-ads/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://app.example.com/api/connect/tiktok-business/callback

# Shopify standalone OAuth app. read_orders is the only requested scope.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://app.example.com/api/connect/shopify/callback
SHOPIFY_API_VERSION=2026-10

# Long random value used by an external cron to call POST /api/connect/sync.
# Send it as `x-cron-secret` or `Authorization: Bearer <value>`.
CRON_SECRET=

# AI provider order; z.ai uses platform credentials, other providers are optional.
# Supported providers: z.ai, openai, groq, openrouter, gemini
AI_GATEWAY_ORDER=z.ai,openai,groq,openrouter,gemini
AI_GATEWAY_TIMEOUT_MS=45000
# Time limit per try for live features (chat turns, check-ins, drafts). Default 20000.
AI_GATEWAY_FAST_TIMEOUT_MS=20000
AI_GATEWAY_COOLDOWN_MS=60000
BIZZ_AI_DISABLED=0

# Add keys for the providers you want to enable. Several keys per provider are
# supported and rotated (least-recently-used, per-key cooldown on 429/401):
#   GROQ_API_KEY=key1,key2           comma-separated in the original variable
#   GROQ_API_KEYS=key3,key4          plural variable, same format
#   GROQ_API_KEY_2=key5              numbered variables (_2, _3, ... any number)
#   GROQ_API_KEY_3=ada:key6          optional "label:" prefix names the contributor
# Unlabelled keys show as groq#1, groq#2... Same pattern for ZAI_, OPENAI_,
# OPENROUTER_ and GEMINI_. Per-key usage: GET /api/ai-gateway (keys masked).
# Usage is saved to a persistent container volume at this path.
AI_GATEWAY_USAGE_FILE=.ai-gateway/usage.json
# AI_GATEWAY_AUTH_PARK_MS=21600000   how long an invalid (401/403) key is parked
# AI_GATEWAY_QUOTA_PARK_MS=3600000   how long an out-of-credits key is parked
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=""
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.5-flash-lite
ZAI_API_KEY=""
ZAI_MODEL=glm-4.7-flash

# Token the team sends as x-review-token to list stored chats (GET /api/chats).
CHAT_REVIEW_TOKEN=

# Secure cookies are the production default. Do not set AUTH_COOKIE_INSECURE on
# the droplet; it exists only for plain-HTTP local/LAN testing.
# AUTH_COOKIE_INSECURE=
# Comma-separated deployment bootstrap allowlist. Prefer assigning an exact
# ADMIN / PLATFORM_ADMIN / SUPER_ADMIN database role once administration is live.
PLATFORM_ADMIN_EMAILS=""

# Throwaway UI-check account for local dev (brand-colour session, 2026-11-21). Use only on http://127.0.0.1:3007.
# UI_CHECK_EMAIL=brand-check-skzifn@nellovia.test
# UI_CHECK_PASSWORD=sWUFp4vSJey2rwR7XC

