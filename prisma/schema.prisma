// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// Neon Postgres is the real database (SQLite was only the early prototype).
// NOTE: the Neon database also holds production tables that are NOT modelled
// here yet — do NOT run `prisma db push` / `migrate` against it from this
// schema, it would try to drop them. New tables are created additively with
// the SQL in prisma/sql/ (see prisma/sql/README.md).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specialist         Specialist?
  marketplaceReviews MarketReview[]       @relation("MarketplaceReviewer")
  marketNotifications MarketNotification[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Specialists marketplace ----------
// Supply side: vetted human specialists who showcase their proficiency
// (Fiverr-style) and bid on tasks posted by business owners.

model Specialist {
  id            String       @id @default(cuid())
  userId        String?      @unique
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  headline      String       @default("") // one-line proficiency statement, e.g. "Meta ads for Lagos retailers"
  category      String       @default("") // marketing | sales | content | design | web | ops | finance | data | people | legal
  skills        String       @default("[]") // JSON string[]; kept for backwards compatibility with the seeded roster
  hourlyRate    Int          @default(0) // NGN per hour (indicative — final price comes from their bid)
  rating        Float        @default(0)
  reviews       Int          @default(0)
  completedJobs Int          @default(0)
  responseTime  String       @default("Within 1 business day")
  location      String       @default("")
  languages     String       @default("[]") // JSON string[]
  bio           String       @default("")
  portfolio     String       @default("[]") // JSON { title: string; blurb: string }[]
  badges        String       @default("[]") // JSON string[] e.g. ["Top rated"]
  available     String       @default("Unavailable")
  verified      Boolean      @default(false)
  status        String       @default("draft") // draft | submitted | approved | rejected | suspended
  onboardingStep Int         @default(1)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  bids          MarketBid[]
  invitations   MarketInvitation[]
  engagements   MarketEngagement[]
  reviewsReceived MarketReview[] @relation("SpecialistReviews")

  @@index([status, category, verified])
  @@index([category, rating])
}

// Demand side: a piece of work posted by an owner — usually from an AI
// recommendation the owner cannot execute in-house.

model MarketTask {
  id           String      @id @default(cuid())
  workspaceId  String
  businessName String
  title        String
  description  String
  category     String
  skills       String      @default("[]") // JSON string[]
  budgetMin    Int?
  budgetMax    Int?
  urgency      String      @default("this-week") // asap | this-week | flexible
  source       String      @default("manual") // recommendation | manual
  sourceRef    String? // recommendation id when AI-sourced
  sourceTitle  String? // recommendation title for context
  status       String      @default("open") // open | awarded | in-progress | delivered | completed | cancelled | disputed | closed
  awardedBidId String?     @unique
  awardedBid   MarketBid?  @relation("AwardedBid", fields: [awardedBidId], references: [id], onDelete: SetNull)
  matchNote    String? // AI matchmaker summary persisted for the record
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  bids         MarketBid[] @relation("TaskBids")
  invitations  MarketInvitation[]
  engagement   MarketEngagement?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, createdAt])
}

model MarketBid {
  id           String     @id @default(cuid())
  taskId       String
  task         MarketTask @relation("TaskBids", fields: [taskId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id])
  amount       Int // NGN total for the task
  days         Int // promised delivery in days
  coverNote    String
  inviteSource String     @default("specialist") // specialist | ai-match | manual
  status       String     @default("pending") // pending | accepted | declined | withdrawn
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  withdrawnAt  DateTime?
  awardedFor   MarketTask? @relation("AwardedBid")
  engagement   MarketEngagement?

  @@unique([taskId, specialistId])
  @@index([taskId, status, createdAt])
  @@index([specialistId, status, createdAt])
}

model MarketInvitation {
  id            String     @id @default(cuid())
  taskId        String
  task          MarketTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  specialistId  String
  specialist    Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  source        String     @default("manual") // manual | ai-match
  status        String     @default("pending") // pending | accepted | declined | expired
  message       String?
  expiresAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([taskId, specialistId])
  @@index([specialistId, status, createdAt])
  @@index([taskId, status])
}

model MarketEngagement {
  id             String        @id @default(cuid())
  taskId         String        @unique
  task           MarketTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  bidId          String        @unique
  bid            MarketBid     @relation(fields: [bidId], references: [id], onDelete: Restrict)
  specialistId   String
  specialist     Specialist    @relation(fields: [specialistId], references: [id], onDelete: Restrict)
  workspaceId    String
  status         String        @default("awarded") // awarded | accepted | in-progress | delivered | completed | cancelled | disputed
  agreedAmount   Int
  deliveryDays   Int
  scope          String
  paymentStatus  String        @default("external") // external | pending | paid | released | refunded
  startedAt      DateTime?
  deliveredAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  disputeReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       MarketMessage[]
  reviews        MarketReview[]

  @@index([workspaceId, status, updatedAt])
  @@index([specialistId, status, updatedAt])
}

model MarketMessage {
  id            String           @id @default(cuid())
  engagementId  String
  engagement    MarketEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  senderUserId  String
  senderRole    String // owner | specialist | system
  body          String
  createdAt     DateTime         @default(now())

  @@index([engagementId, createdAt])
}

model MarketReview {
  id                   String           @id @default(cuid())
  engagementId         String
  engagement           MarketEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  reviewerUserId       String
  reviewer             User             @relation("MarketplaceReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  revieweeSpecialistId String
  revieweeSpecialist   Specialist       @relation("SpecialistReviews", fields: [revieweeSpecialistId], references: [id], onDelete: Cascade)
  rating               Int
  comment              String
  createdAt            DateTime         @default(now())

  @@unique([engagementId, reviewerUserId])
  @@index([revieweeSpecialistId, createdAt])
}

model MarketNotification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// ---------- Chat conversation log ----------
// Every AI chat (onboarding checkup, Ask, ...) is stored here so the team can
// review conversation quality, and so an owner can resume where they stopped.
// No foreign keys: workspaces in the client app are not yet Neon Workspace rows.

model ChatConversation {
  id            String        @id // client-generated, unguessable
  chatType      String // "onboarding-checkup" | "ask" | ...
  screen        String // screen/route the chat ran on, e.g. "onboarding-chat"
  clientId      String? // anonymous per-browser id (no auth yet)
  workspaceId   String?
  workspaceName String?
  country       String?
  phase         String? // e.g. "interview" | "done"
  slots         Json? // facts extracted so far (checkup slots)
  facts         Json? // final structured facts, when the chat finished
  meta          Json?
  messageCount  Int           @default(0)
  source        String        @default("live") // live | captured (backfilled from an open page)
  startedAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]

  @@index([chatType, updatedAt])
  @@index([workspaceId])
  @@index([clientId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seq            Int // 0-based order within the conversation
  role           String // "ai" | "user"
  text           String
  meta           Json? // learned chips, suggested chips, degraded flag, ...
  sentAt         DateTime
  createdAt      DateTime         @default(now())

  @@unique([conversationId, seq])
  @@index([conversationId])
}

// ---------- Third-party data connections ----------
// Created additively by prisma/sql/003_connections.sql (never `db push`).
// Read and written with raw SQL in src/lib/connectors/store.ts, like
// AuthSession, so no client regeneration is needed. userId references
// "User"("id") with ON DELETE CASCADE in the SQL (not modelled as a relation
// because the User model here is only a partial copy of the Neon table).
// Tokens are AES-256-GCM encrypted (key: CONNECTIONS_ENCRYPTION_KEY).

model ConnectorCredential {
  id              String       @id
  userId          String
  provider        String
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scopes          String       @default("")
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  connections     Connection[]

  @@unique([userId, provider])
}

model Connection {
  id                   String              @id
  userId               String
  workspaceId          String?
  credentialId         String
  credential           ConnectorCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  provider             String // connector id, e.g. "google"
  product              String // "search-console" | "analytics"
  externalAccountId    String? // e.g. "sc-domain:example.com" or "properties/123456"
  externalAccountLabel String?
  config               Json? // Product-specific, non-secret mapping (for example Sheet columns)
  scopes               String        @default("") // space-separated, as granted
  status               String        @default("pending") // pending | syncing | connected | error
  progress             Json? // { step, total, label } while a sync runs
  error                String? // plain-language reason when status = error
  errorCode            String? // e.g. invalid_grant, api_disabled, no_access
  lastSyncAt           DateTime?
  syncStartedAt        DateTime?
  dataFrom             DateTime?     @db.Date
  dataTo               DateTime?     @db.Date
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now())
  metrics              MetricDaily[]

  @@unique([userId, provider, product])
  @@index([credentialId])
  @@index([status, lastSyncAt])
}

model MetricDaily {
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  metric         String // e.g. clicks, impressions, sessions, keyEvents
  dimension      String     @default("") // "" = the day's total | query | page | channel | window
  dimensionValue String     @default("")
  date           DateTime   @db.Date
  value          Float
  updatedAt      DateTime   @default(now())

  @@id([connectionId, metric, dimension, dimensionValue, date])
  @@index([connectionId, date])
}

model IntegrationInterest {
  id        String   @id
  userId    String
  platform  String // catalogue id, e.g. "paystack"
  createdAt DateTime @default(now())

  @@unique([userId, platform])
  @@index([platform])
}
